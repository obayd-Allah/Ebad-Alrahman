* { margin: 0px; padding: 0px; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { direction: rtl; font-family: Cairo, sans-serif; color: rgb(36, 66, 93); background: linear-gradient(rgb(143, 216, 255), rgb(223, 246, 255) 35%, rgb(219, 243, 255) 70%); min-height: 100vh; overflow-x: hidden; position: relative; }

body::before { content: ""; position: fixed; inset: 0px; pointer-events: none; background: radial-gradient(circle at 10% 12%, rgba(255, 255, 255, 0.95) 0px, rgba(255, 255, 255, 0.95) 22px, transparent 23px), radial-gradient(circle at 82% 18%, rgba(255, 255, 255, 0.9) 0px, rgba(255, 255, 255, 0.9) 18px, transparent 19px), radial-gradient(circle at 30% 82%, rgba(255, 255, 255, 0.85) 0px, rgba(255, 255, 255, 0.85) 14px, transparent 15px), radial-gradient(circle at 70% 70%, rgba(255, 255, 255, 0.9) 0px, rgba(255, 255, 255, 0.9) 20px, transparent 21px); opacity: 0.85; z-index: -2; }

body::after { content: ""; position: fixed; inset: 0px; pointer-events: none; background-image: radial-gradient(rgb(255, 233, 93) 2px, transparent 3px), radial-gradient(rgb(255, 95, 160) 2px, transparent 3px), radial-gradient(rgb(68, 210, 106) 2px, transparent 3px), radial-gradient(rgb(95, 157, 255) 2px, transparent 3px); background-size: 210px 210px, 260px 260px, 320px 320px, 170px 170px; background-position: 20px 30px, 150px 80px, 80px 170px, 220px 150px; opacity: 0.55; z-index: -1; }

a { text-decoration: none; color: inherit; transition: all 0.25s ease 0s; }

.container { max-width: 1180px; margin: auto; padding: 25px 18px 50px; }

.hero-title { width: min(92%, 650px); display: block; margin: 15px auto 0px; filter: drop-shadow(rgba(0, 0, 0, 0.25) 0px 10px 18px); animation: 3s ease-in-out 0s infinite normal none running titleFloat; }

@media (max-width: 768px) {
  .hero-title { width: 95%; max-width: 500px; }
}

.hero { min-height: 320px; height: auto; position: relative; overflow: hidden; display: flex; justify-content: center; align-items: center; text-align: center; padding: 25px; background: linear-gradient(rgb(68, 184, 255) 0%, rgb(111, 211, 255) 45%, rgb(159, 230, 255) 100%); border-bottom-left-radius: 40px; border-bottom-right-radius: 40px; box-shadow: rgba(0, 0, 0, 0.15) 0px 14px 40px; }

.hero::before { content: ""; position: absolute; inset: 0px; background-image: radial-gradient(circle at 18% 20%, rgb(255, 255, 255) 0px, rgb(255, 255, 255) 42px, transparent 43px), radial-gradient(circle at 25% 22%, rgb(255, 255, 255) 0px, rgb(255, 255, 255) 30px, transparent 31px), radial-gradient(circle at 74% 16%, rgb(255, 255, 255) 0px, rgb(255, 255, 255) 36px, transparent 37px), radial-gradient(circle at 80% 18%, rgb(255, 255, 255) 0px, rgb(255, 255, 255) 26px, transparent 27px), radial-gradient(circle at 55% 9%, rgb(255, 255, 255) 0px, rgb(255, 255, 255) 24px, transparent 25px); background-repeat: no-repeat; opacity: 0.95; pointer-events: none; }

.hero::after { content: ""; position: absolute; inset: 0px; background: linear-gradient(rgba(255, 255, 255, 0.35), transparent 40%); pointer-events: none; }

.overlay { position: relative; z-index: 2; width: 100%; }

.logo { height: 200px; object-fit: contain; width: 90%; max-width: 360px; display: block; margin: 15px auto 0px; padding: 8px; border-radius: 50%; box-shadow: rgba(0, 0, 0, 0.18) 0px 10px 25px, rgba(255, 255, 255, 0.28) 0px 0px 0px 8px; transition: all 0.35s ease 0s; }

.logo:hover { transform: rotate(-6deg) scale(1.1); }

.hero h1 { font-size: 58px; font-weight: 900; line-height: 1.15; background: linear-gradient(rgb(255, 106, 168) 0%, rgb(255, 47, 118) 100%) text; -webkit-text-fill-color: transparent; -webkit-text-stroke: 8px rgb(255, 255, 255); text-shadow: rgb(255, 157, 196) 0px 4px 0px, rgb(229, 29, 99) 0px 8px 0px, rgba(0, 0, 0, 0.18) 0px 12px 18px; filter: drop-shadow(rgba(0, 0, 0, 0.18) 0px 8px 10px); letter-spacing: 1px; }

.game-title { font-size: 58px; font-weight: 900; }

.game-title span { display: inline-block; -webkit-text-stroke: 8px white; text-shadow: rgba(0, 0, 0, 0.12) 0px 4px 0px, rgba(0, 0, 0, 0.18) 0px 8px 10px; margin: 0px 6px; }

.pink { color: rgb(255, 61, 131); }

.green { color: rgb(85, 216, 58); }

.blue { color: rgb(47, 124, 255); }

.subtitle { margin-top: 18px; font-size: 25px; font-weight: 800; color: rgb(255, 243, 77); text-shadow: rgb(217, 121, 0) 0px 3px 0px, rgba(0, 0, 0, 0.25) 0px 6px 15px; letter-spacing: 0.5px; animation: 3s ease-in-out 0s infinite normal none running titleFloat; }

@keyframes titleFloat { 
  0% { transform: translateY(0px); }
  50% { transform: translateY(-4px); }
  100% { transform: translateY(0px); }
}

.search-box { margin: 30px auto; position: relative; }

.search-box input { width: 100%; padding: 18px 24px; font-size: 19px; font-weight: 700; border: none; outline: none; border-radius: 24px; background: rgb(255, 255, 255); color: rgb(48, 80, 107); box-shadow: rgb(214, 231, 245) 0px 8px 0px, rgba(39, 112, 170, 0.18) 0px 15px 30px; transition: all 0.25s ease 0s; }

.search-box input::placeholder { color: rgb(137, 163, 184); font-weight: 700; }

.search-box input:focus { transform: translateY(-2px); box-shadow: rgb(200, 221, 240) 0px 10px 0px, rgba(52, 143, 214, 0.28) 0px 20px 35px; }

.filters { display: flex; justify-content: center; gap: 18px; flex-wrap: wrap; margin-bottom: 35px; }

.filter-btn { border: none; cursor: pointer; padding: 16px 34px; font-size: 18px; font-weight: 800; border-radius: 22px; background: linear-gradient(rgb(255, 255, 255), rgb(234, 245, 255)); color: rgb(53, 96, 127); box-shadow: rgb(191, 214, 232) 0px 7px 0px, rgba(0, 0, 0, 0.12) 0px 14px 25px; transition: all 0.18s ease 0s; }

.filter-btn:hover { transform: translateY(-3px); }

.filter-btn:active { transform: translateY(4px); box-shadow: rgb(191, 214, 232) 0px 2px 0px, rgba(0, 0, 0, 0.12) 0px 8px 15px; }

.filter-btn.active { background: linear-gradient(rgb(70, 217, 109), rgb(39, 185, 85)); color: rgb(255, 255, 255); box-shadow: rgb(29, 141, 64) 0px 7px 0px, rgba(39, 172, 73, 0.32) 0px 15px 30px; }

.statistics { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 25px; margin-bottom: 45px; }

.stat-card { background: linear-gradient(rgb(255, 255, 255), rgb(238, 249, 255)); border-radius: 28px; padding: 22px; display: flex; align-items: center; gap: 18px; position: relative; overflow: hidden; box-shadow: rgb(215, 232, 247) 0px 8px 0px, rgba(0, 0, 0, 0.1) 0px 18px 30px; transition: all 0.25s ease 0s; }

.stat-card:hover { transform: translateY(-5px) rotate(-1deg); }

.stat-card::before { content: ""; position: absolute; top: -70px; left: -60px; width: 160px; height: 160px; background: rgba(255, 255, 255, 0.45); border-radius: 50%; }

.stat-icon { width: 70px; height: 70px; display: flex; justify-content: center; align-items: center; font-size: 34px; border-radius: 50%; background: linear-gradient(rgb(255, 213, 77), rgb(255, 179, 0)); box-shadow: rgb(217, 145, 0) 0px 5px 0px, rgba(0, 0, 0, 0.15) 0px 10px 18px; flex-shrink: 0; }

.stat-card h3 { font-size: 19px; font-weight: 800; color: rgb(43, 85, 114); margin-bottom: 6px; }

.stat-card p { font-size: 34px; font-weight: 900; color: rgb(27, 139, 83); text-shadow: rgb(200, 255, 224) 0px 2px 0px; }

.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 28px; margin-bottom: 45px; }

.student-card { position: relative; overflow: hidden; background: linear-gradient(rgb(255, 255, 255), rgb(244, 251, 255)); border-radius: 30px; padding: 24px; border: 5px solid rgb(255, 255, 255); box-shadow: rgb(216, 234, 248) 0px 10px 0px, rgba(0, 0, 0, 0.12) 0px 22px 35px; transition: all 0.28s ease 0s; }

.student-card::after { content: ""; position: absolute; top: -120px; left: -60px; width: 220px; height: 220px; border-radius: 50%; background: rgba(255, 255, 255, 0.42); pointer-events: none; }

.student-card::before { content: ""; position: absolute; right: 0px; top: 0px; width: 12px; height: 100%; background: linear-gradient(rgb(71, 216, 109), rgb(34, 182, 82)); }

.student-card:hover { transform: translateY(-10px) rotate(-1deg); box-shadow: rgb(204, 226, 245) 0px 14px 0px, rgba(0, 0, 0, 0.16) 0px 28px 40px; }

.student-name { font-size: 26px; font-weight: 900; color: rgb(36, 89, 125); margin-bottom: 22px; line-height: 1.4; text-shadow: rgb(255, 255, 255) 0px 2px 0px; }

.student-info { display: flex; justify-content: space-between; align-items: center; padding: 12px 0px; font-size: 18px; font-weight: 700; border-bottom: 2px dashed rgb(217, 237, 249); }

.points { display: inline-flex; align-items: center; justify-content: center; min-width: 70px; padding: 8px 14px; border-radius: 18px; background: linear-gradient(rgb(72, 218, 115), rgb(33, 182, 80)); color: rgb(255, 255, 255); font-size: 24px; font-weight: 900; box-shadow: rgb(22, 129, 58) 0px 5px 0px; }

.rank { display: inline-block; margin-top: 18px; padding: 12px 22px; border-radius: 18px; font-size: 18px; font-weight: 800; background: linear-gradient(rgb(223, 243, 255), rgb(201, 235, 255)); color: rgb(37, 98, 140); box-shadow: rgb(167, 215, 246) 0px 5px 0px; }

.girl-card { background: linear-gradient(rgb(255, 247, 252), rgb(255, 238, 248)); }

.girl-card::before { background: linear-gradient(rgb(255, 132, 195), rgb(236, 90, 165)); }

.girl-card .student-name { color: rgb(203, 61, 137); }

.girl-card .points { background: linear-gradient(rgb(255, 147, 203), rgb(235, 92, 167)); box-shadow: rgb(200, 62, 135) 0px 5px 0px; }

.girl-card .rank { background: linear-gradient(rgb(255, 227, 242), rgb(255, 208, 234)); color: rgb(201, 63, 138); box-shadow: rgb(243, 184, 217) 0px 5px 0px; }

.gold { background: linear-gradient(rgb(255, 248, 214), rgb(255, 232, 143)); }

.gold::before { background: linear-gradient(rgb(255, 215, 79), rgb(230, 171, 0)); }

.silver { background: linear-gradient(rgb(255, 255, 255), rgb(237, 242, 246)); }

.silver::before { background: linear-gradient(rgb(216, 222, 227), rgb(168, 178, 186)); }

.gold { background: linear-gradient(rgb(255, 249, 217) 0%, rgb(255, 233, 122) 30%, rgb(255, 212, 71) 60%, rgb(255, 191, 31) 100%); border: 4px solid rgb(212, 175, 55); }

.gold::before { background: linear-gradient(rgb(255, 226, 122), rgb(212, 155, 0)); }

.silver { background: linear-gradient(rgb(248, 250, 251) 0%, rgb(223, 228, 234) 30%, rgb(188, 197, 207) 60%, rgb(233, 237, 242) 100%); border: 4px solid rgb(181, 188, 197); }

.silver::before { background: linear-gradient(rgb(214, 220, 227), rgb(141, 152, 165)); }

.bronze { background: linear-gradient(rgb(255, 244, 230) 0%, rgb(239, 190, 139) 35%, rgb(207, 131, 71) 70%, rgb(168, 92, 37) 100%); border: 4px solid rgb(184, 115, 51); }

.bronze::before { background: linear-gradient(rgb(215, 154, 98), rgb(143, 77, 29)); }

.gold .points { background: linear-gradient(rgb(255, 216, 77), rgb(226, 169, 0)); box-shadow: rgb(185, 133, 0) 0px 5px 0px; }

.silver .points { background: linear-gradient(rgb(217, 223, 230), rgb(152, 163, 177)); box-shadow: rgb(119, 130, 144) 0px 5px 0px; }

.bronze .points { background: linear-gradient(rgb(217, 154, 98), rgb(168, 92, 37)); box-shadow: rgb(124, 63, 21) 0px 5px 0px; }

.floating-reward-btn { position: fixed; bottom: 25px; right: 25px; transform: translateX(-50%) translateY(80px); width: 60px; height: 60px; border: none; border-radius: 50%; background: rgb(0, 184, 148); color: rgb(255, 255, 255); font-size: 28px; cursor: pointer; opacity: 0; pointer-events: none; transition: all 0.35s ease 0s; z-index: 9999; }

.floating-reward-btn.show { opacity: 1; pointer-events: auto; transform: translateX(-50%) translateY(0px); }

.loading { text-align: center; padding: 70px 20px; font-size: 28px; font-weight: 900; color: rgb(43, 94, 131); animation: 1.1s ease 0s infinite normal none running loadingJump; }

@keyframes loadingJump { 
  0% { transform: translateY(0px); }
  50% { transform: translateY(-8px); }
